# ==========================================
# Frontend Vercel Environment Variables
# ==========================================

# Public API URL pointing to the NestJS backend
# For local development: http://localhost:4000/api/v1
# For Vercel production: https://<your-backend-app>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Default tenant workspace identifier
NEXT_PUBLIC_DEFAULT_TENANT_ID=tenant-default

# Demo access flag
NEXT_PUBLIC_ACCESS_ENABLED=true
