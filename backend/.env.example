# ==========================================
# Backend Render / Local Environment Configuration
# ==========================================

# Server & Runtime
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
DEFAULT_TENANT_ID=tenant-default

# Shared AI Platform Service Integration
# Required for live embedding, vector retrieval, and LLM-as-a-judge evaluation
# When unset or unreachable, deterministic local simulator adapter is automatically used with explicit labeling
AI_PLATFORM_URL=http://localhost:5000
AI_PLATFORM_API_KEY=
AI_PLATFORM_TIMEOUT_MS=10000
AI_PLATFORM_APPLICATION_ID=ai-rag-quality-ops

# Model Regression Detection Service Integration
# Used to enforce baseline quality checks and detect retrieval regressions across versions
# When unset or unreachable, local deterministic regression engine evaluates threshold deltas
MODEL_REGRESSION_SERVICE_URL=http://localhost:4002
MODEL_REGRESSION_SERVICE_API_KEY=
MODEL_REGRESSION_SERVICE_TIMEOUT_MS=8000

# Shared Notification Service Integration
# Sends alerts for stale knowledge warnings, benchmark regressions, and doc edit review requests
# When unset or unreachable, notifications fail gracefully without disrupting evaluations
NOTIFICATION_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_API_KEY=
NOTIFICATION_SERVICE_TIMEOUT_MS=5000
NOTIFICATION_ALERT_RECIPIENT_EMAIL=ops-alerts@example.com

# Knowledge Safety & SSRF Protection
# Comma-separated domains explicitly allowed for external document freshness checks
ALLOWED_EXTERNAL_SOURCE_DOMAINS=docs.example.com,api.example.com,raw.githubusercontent.com
MAX_DOCUMENT_SIZE_BYTES=5242880
FRESHNESS_CHECK_TIMEOUT_MS=5000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
